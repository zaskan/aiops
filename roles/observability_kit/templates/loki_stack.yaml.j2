---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ observability_kit_loki_name }}-config
  namespace: {{ observability_kit_namespace }}
  labels:
    app.kubernetes.io/name: {{ observability_kit_loki_name }}
    app.kubernetes.io/part-of: aiops-observability
data:
  loki.yaml: |
    auth_enabled: false
    server:
      http_listen_port: {{ observability_kit_loki_port }}
      grpc_listen_port: 9096
      log_level: info
    common:
      path_prefix: /tmp/loki
      storage:
        filesystem:
          chunks_directory: /tmp/loki/chunks
          rules_directory: /tmp/loki/rules
      replication_factor: 1
      ring:
        kvstore:
          store: inmemory
    schema_config:
      configs:
        - from: "2024-01-01"
          store: tsdb
          object_store: filesystem
          schema: v13
          index:
            prefix: index_
            period: 24h
    limits_config:
      allow_structured_metadata: true
      volume_enabled: true
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ observability_kit_loki_name }}
  namespace: {{ observability_kit_namespace }}
  labels:
    app.kubernetes.io/name: {{ observability_kit_loki_name }}
    app.kubernetes.io/part-of: aiops-observability
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ observability_kit_loki_name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ observability_kit_loki_name }}
    spec:
      containers:
        - name: loki
          image: {{ observability_kit_loki_image }}
          args:
            - -config.file=/etc/loki/loki.yaml
            - -target=all
          ports:
            - name: http
              containerPort: {{ observability_kit_loki_port }}
          readinessProbe:
            httpGet:
              path: /ready
              port: http
            initialDelaySeconds: 15
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /ready
              port: http
            initialDelaySeconds: 30
            periodSeconds: 20
          volumeMounts:
            - name: config
              mountPath: /etc/loki
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: "1"
              memory: 1Gi
      volumes:
        - name: config
          configMap:
            name: {{ observability_kit_loki_name }}-config
---
apiVersion: v1
kind: Service
metadata:
  name: {{ observability_kit_loki_name }}
  namespace: {{ observability_kit_namespace }}
  labels:
    app.kubernetes.io/name: {{ observability_kit_loki_name }}
    app.kubernetes.io/part-of: aiops-observability
spec:
  selector:
    app.kubernetes.io/name: {{ observability_kit_loki_name }}
  ports:
    - name: http
      port: {{ observability_kit_loki_port }}
      targetPort: http
