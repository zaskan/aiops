---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: {{ observability_kit_aap_log_collector_name }}
  namespace: {{ observability_kit_aap_namespace }}
  labels:
    app.kubernetes.io/name: {{ observability_kit_aap_log_collector_name }}
    app.kubernetes.io/part-of: aiops-observability
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ observability_kit_aap_log_collector_name }}-config
  namespace: {{ observability_kit_aap_namespace }}
  labels:
    app.kubernetes.io/name: {{ observability_kit_aap_log_collector_name }}
    app.kubernetes.io/part-of: aiops-observability
data:
  config.yaml: |
    receivers:
      filelog/aap:
        include:
          - /var/log/pods/{{ observability_kit_aap_namespace }}_*/*/*.log
        start_at: end
        include_file_path: true
        operators:
          - type: container
            id: container-parser

    processors:
      batch:
        timeout: 1s
      resource:
        attributes:
          - key: service.namespace
            value: {{ observability_kit_aap_namespace }}
            action: upsert

    exporters:
      otlp/upstream:
        endpoint: {{ observability_kit_aap_log_otlp_endpoint }}
        tls:
          insecure: true

    service:
      pipelines:
        logs:
          receivers: [filelog/aap]
          processors: [resource, batch]
          exporters: [otlp/upstream]
---
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: {{ observability_kit_aap_log_collector_name }}
  namespace: {{ observability_kit_aap_namespace }}
  labels:
    app.kubernetes.io/name: {{ observability_kit_aap_log_collector_name }}
    app.kubernetes.io/part-of: aiops-observability
spec:
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ observability_kit_aap_log_collector_name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ observability_kit_aap_log_collector_name }}
    spec:
      serviceAccountName: {{ observability_kit_aap_log_collector_name }}
      containers:
        - name: otel-collector
          image: {{ observability_kit_aap_log_forwarder_image }}
          args:
            - --config=/etc/otel/config.yaml
          volumeMounts:
            - name: config
              mountPath: /etc/otel
            - name: varlogpods
              mountPath: /var/log/pods
              readOnly: true
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi
      volumes:
        - name: config
          configMap:
            name: {{ observability_kit_aap_log_collector_name }}-config
        - name: varlogpods
          hostPath:
            path: /var/log/pods
            type: Directory
