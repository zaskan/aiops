---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ observability_kit_collector_downstream_name }}-config
  namespace: {{ observability_kit_namespace }}
  labels:
    app.kubernetes.io/name: {{ observability_kit_collector_downstream_name }}
    app.kubernetes.io/part-of: aiops-observability
data:
  config.yaml: |
    extensions:
      health_check:
        endpoint: 0.0.0.0:13133

    receivers:
      kafka/aap:
        brokers:
          - {{ observability_kit_kafka_internal_bootstrap }}
        topic: {{ observability_kit_kafka_topic_aap_logs }}
        encoding: raw
        group_id: otel-collector-downstream-aap-raw
        initial_offset: latest
        protocol_version: 2.0.0

      kafka/alertmanager:
        brokers:
          - {{ observability_kit_kafka_internal_bootstrap }}
        topic: {{ observability_kit_kafka_topic_alertmanager }}
        encoding: raw
        group_id: otel-collector-downstream-alertmanager
        protocol_version: 2.0.0

      kafka/itsm:
        brokers:
          - {{ observability_kit_kafka_internal_bootstrap }}
        topic: {{ observability_kit_kafka_topic_itsm }}
        encoding: raw
        group_id: otel-collector-downstream-itsm
        protocol_version: 2.0.0

    processors:
      batch:
        timeout: 1s
        send_batch_size: 256

      transform/aap:
        log_statements:
          - context: log
            statements:
              - set(resource.attributes["aiops_source"], "aap")
              - set(resource.attributes["service_namespace"], "{{ observability_kit_aap_namespace }}")
              - merge_maps(cache, ParseJSON(body), "upsert") where IsString(body)
              - merge_maps(cache, body, "upsert") where IsMap(body)
              - set(body, ParseJSON(body)) where IsString(body)
              - merge_maps(cache, body, "upsert") where IsMap(body)
              - set(resource.attributes["aap_logger"], cache["logger"]) where cache["logger"] != nil
              - set(resource.attributes["aap_logger"], cache["logger_name"]) where cache["logger_name"] != nil and cache["logger"] == nil
              - set(body, String(cache)) where IsMap(cache)

      transform/alertmanager:
        log_statements:
          - context: log
            statements:
              - set(resource.attributes["aiops_source"], "alertmanager")
              - merge_maps(cache, ParseJSON(body), "upsert") where IsString(body)
              - merge_maps(cache, body, "upsert") where IsMap(body)
              - set(body, ParseJSON(body)) where IsString(body)
              - merge_maps(cache, body, "upsert") where IsMap(body)
              - set(resource.attributes["alert_status"], cache["payload"]["status"]) where cache["payload"]["status"] != nil
              - set(resource.attributes["alert_status"], cache["status"]) where cache["status"] != nil
              - set(resource.attributes["alertname"], cache["payload"]["commonLabels"]["alertname"]) where cache["payload"]["commonLabels"]["alertname"] != nil
              - set(resource.attributes["alertname"], cache["commonLabels"]["alertname"]) where cache["commonLabels"]["alertname"] != nil
              - set(resource.attributes["vm_name"], cache["payload"]["commonLabels"]["vm_name"]) where cache["payload"]["commonLabels"]["vm_name"] != nil
              - set(resource.attributes["vm_name"], cache["commonLabels"]["vm_name"]) where cache["commonLabels"]["vm_name"] != nil
              - set(body, String(cache["payload"])) where cache["payload"] != nil
              - set(body, String(cache)) where cache["payload"] == nil

      transform/itsm:
        log_statements:
          - context: log
            statements:
              - set(resource.attributes["aiops_source"], "itsm")
              - merge_maps(cache, ParseJSON(body), "upsert") where IsString(body)
              - merge_maps(cache, body, "upsert") where IsMap(body)
              - set(body, ParseJSON(body)) where IsString(body)
              - merge_maps(cache, body, "upsert") where IsMap(body)
              - set(resource.attributes["itsm_event"], cache["payload"]["event"]) where cache["payload"]["event"] != nil
              - set(resource.attributes["itsm_event"], cache["event"]) where cache["event"] != nil
              - set(resource.attributes["itsm_public_id"], cache["payload"]["incident"]["public_id"]) where cache["payload"]["incident"]["public_id"] != nil
              - set(resource.attributes["itsm_public_id"], cache["incident"]["public_id"]) where cache["incident"]["public_id"] != nil
              - set(resource.attributes["itsm_public_id"], cache["payload"]["request"]["public_id"]) where cache["payload"]["request"]["public_id"] != nil
              - set(resource.attributes["itsm_public_id"], cache["request"]["public_id"]) where cache["request"]["public_id"] != nil
              - set(body, String(cache["payload"])) where cache["payload"] != nil
              - set(body, String(cache)) where cache["payload"] == nil

    exporters:
      otlphttp/loki:
        endpoint: {{ observability_kit_loki_internal_url }}/otlp
        tls:
          insecure: true

    service:
      extensions: [health_check]
      pipelines:
        logs/aap:
          receivers: [kafka/aap]
          processors: [transform/aap, batch]
          exporters: [otlphttp/loki]
        logs/alertmanager:
          receivers: [kafka/alertmanager]
          processors: [transform/alertmanager, batch]
          exporters: [otlphttp/loki]
        logs/itsm:
          receivers: [kafka/itsm]
          processors: [transform/itsm, batch]
          exporters: [otlphttp/loki]
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ observability_kit_collector_downstream_name }}
  namespace: {{ observability_kit_namespace }}
  labels:
    app.kubernetes.io/name: {{ observability_kit_collector_downstream_name }}
    app.kubernetes.io/part-of: aiops-observability
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ observability_kit_collector_downstream_name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ observability_kit_collector_downstream_name }}
      annotations:
        checksum/config: "{{ observability_kit_collector_downstream_config_checksum | default('') }}"
    spec:
      containers:
        - name: otel-collector
          image: {{ observability_kit_otel_collector_image }}
          args:
            - --config=/etc/otel/config.yaml
          ports:
            - name: health
              containerPort: 13133
          readinessProbe:
            httpGet:
              path: /
              port: health
            initialDelaySeconds: 10
            periodSeconds: 10
          livenessProbe:
            httpGet:
              path: /
              port: health
            initialDelaySeconds: 20
            periodSeconds: 20
          volumeMounts:
            - name: config
              mountPath: /etc/otel
          resources:
            requests:
              cpu: 100m
              memory: 256Mi
            limits:
              cpu: "1"
              memory: 512Mi
      volumes:
        - name: config
          configMap:
            name: {{ observability_kit_collector_downstream_name }}-config
---
apiVersion: v1
kind: Service
metadata:
  name: {{ observability_kit_collector_downstream_name }}
  namespace: {{ observability_kit_namespace }}
  labels:
    app.kubernetes.io/name: {{ observability_kit_collector_downstream_name }}
    app.kubernetes.io/part-of: aiops-observability
spec:
  selector:
    app.kubernetes.io/name: {{ observability_kit_collector_downstream_name }}
  ports:
    - name: health
      port: 13133
      targetPort: health
