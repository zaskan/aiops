{
  "uid": "aiops-aap-logs",
  "title": "AAP Platform Logs",
  "tags": ["aiops", "aap"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "AAP log volume",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({aiops_source=\"aap\"}[5m]))",
          "legendFormat": "logs",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "AAP logs by service namespace",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (service_namespace) (count_over_time({aiops_source=\"aap\"}[5m]))",
          "legendFormat": "{{service_namespace}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error and warning lines",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({aiops_source=\"aap\"} |~ \"(?i)(error|warn|fatal)\" [5m]))",
          "legendFormat": "error/warn",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Live AAP platform logs",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{aiops_source=\"aap\"}",
          "refId": "A"
        }
      ],
      "options": { "showTime": true, "sortOrder": "Descending" }
    }
  ],
  "templating": { "list": [] }
}
