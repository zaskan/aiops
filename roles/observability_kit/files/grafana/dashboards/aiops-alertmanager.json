{
  "uid": "aiops-alertmanager",
  "title": "Alertmanager Events",
  "tags": ["aiops", "alertmanager"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Firing alerts (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({aiops_source=\"alertmanager\", alert_status=\"firing\"}[1h]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "ApacheApplicationDown events",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (vm_name) (count_over_time({aiops_source=\"alertmanager\", alertname=\"ApacheApplicationDown\"}[5m]))",
          "legendFormat": "{{vm_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Alert events by alertname",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (alertname) (count_over_time({aiops_source=\"alertmanager\"}[5m]))",
          "legendFormat": "{{alertname}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Alert events by VM",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "sum by (vm_name) (count_over_time({aiops_source=\"alertmanager\"}[5m]))",
          "legendFormat": "{{vm_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "logs",
      "title": "Alertmanager event log",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{aiops_source=\"alertmanager\"}",
          "refId": "A"
        }
      ],
      "options": { "showTime": true, "sortOrder": "Descending" }
    }
  ],
  "templating": { "list": [] }
}
