diff --git a/app/services/runtime_purge.py b/app/services/runtime_purge.py
new file mode 100644
index 0000000..278dee3
--- /dev/null
+++ b/app/services/runtime_purge.py
@@ -0,0 +1,50 @@
+"""Runtime data purge — delete operational records while preserving catalog."""
+
+from __future__ import annotations
+
+from app import db
+from app.services import users_admin as usr_svc
+
+RUNTIME_PURGE_CONFIRM_PHRASE = "DELETE RUNTIME DATA"
+
+_RUNTIME_PURGE_TABLES: tuple[str, ...] = (
+    "workflow_events",
+    "change_tasks",
+    "change_requests",
+    "requested_items",
+    "service_requests",
+    "request_comments",
+    "comments",
+    "incident_events",
+    "incidents",
+    "inventory_assets",
+)
+
+
+def purge_runtime_data(*, actor_admin_id: int) -> dict[str, int]:
+    """Delete operational ITSM records; preserve templates, KB, and asset types."""
+    actor = usr_svc.get_user(actor_admin_id)
+    if not actor or actor.get("role") != "admin":
+        raise ValueError("Administrator access required")
+
+    deleted: dict[str, int] = {}
+
+    with db.cursor() as cur:
+        cur.execute("PRAGMA foreign_keys = OFF")
+        try:
+            for table in _RUNTIME_PURGE_TABLES:
+                cur.execute(
+                    "SELECT name FROM sqlite_master WHERE type='table' AND name=?",
+                    (table,),
+                )
+                if not cur.fetchone():
+                    continue
+                cur.execute(f"DELETE FROM {table}")  # noqa: S608
+                deleted[table] = cur.rowcount
+
+            for table in _RUNTIME_PURGE_TABLES:
+                cur.execute("DELETE FROM sqlite_sequence WHERE name = ?", (table,))
+        finally:
+            cur.execute("PRAGMA foreign_keys = ON")
+
+    return deleted
