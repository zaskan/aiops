---
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: {{ openshift_apache_monitoring_prometheus_rule_name }}
  namespace: {{ openshift_apache_monitoring_namespace }}
  labels:
    openshift.io/user-monitoring: "true"
    openshift.io/prometheus-rule-evaluation-scope: leaf-prometheus
spec:
  groups:
    - name: apache-http-probes
      rules:
        - alert: {{ openshift_apache_monitoring_alert_name }}
          expr: >-
            probe_success{job="{{ openshift_apache_monitoring_probe_job }}"} == 0
            and on(instance)
            count_over_time(probe_success{job="{{ openshift_apache_monitoring_probe_job }}"}[{{ openshift_apache_monitoring_probe_lookback | default('1m') }}]) > 0
          for: {{ openshift_apache_monitoring_probe_for | default('15s') }}
          labels:
            severity: user
          annotations:
            summary: "{% raw %}Apache HTTP probe failed for {{ $labels.vm_name }} ({{ $labels.instance }}){% endraw %}"
            description: "{% raw %}Service HTTP probe is failing for VM {{ $labels.vm_name }}{% endraw %} in namespace {{ openshift_apache_monitoring_namespace }}."
