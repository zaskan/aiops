---
apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: {{ apache_exposure_route_name }}
  namespace: {{ vm_namespace }}
spec:
  host: {{ apache_exposure_route_host }}
  to:
    kind: Service
    name: {{ apache_exposure_service_name }}
  port:
    targetPort: {{ apache_exposure_service_port }}
